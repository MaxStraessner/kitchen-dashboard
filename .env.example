APP_ENV=development
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_HOURS=24
AUTH_REMEMBER_TTL_DAYS=30
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173
APP_TIMEZONE=Europe/Berlin
APP_HTTP_PORT=8081
BACKEND_PORT=8002
DATABASE_URL=postgresql+asyncpg://kitchen_dashboard:change-me@kitchen-dashboard-postgres:5432/kitchen_dashboard
POSTGRES_DB=kitchen_dashboard
POSTGRES_USER=kitchen_dashboard
POSTGRES_PASSWORD=change-me
WEATHER_LOCATION_NAME=Unna
WEATHER_LATITUDE=51.537
WEATHER_LONGITUDE=7.689
WEATHER_CACHE_TTL_SECONDS=900
CALENDAR_CACHE_TTL_SECONDS=60
# JSON array of source objects. Keep real private ICS URLs only in .env, never in Git.
CALENDAR_SOURCES_JSON=[]
# Optional Bring integration. Set real values only in the protected host configuration.
BRING_ENABLED=
BRING_EMAIL=
BRING_PASSWORD=
BRING_LIST_UUID=
# Shared camera mode. The browser URL is intentionally credential-free; production
# resolves it through the authenticated same-origin proxy to the internal go2rtc service.
CAMERA_MODE_TIMEOUT_MINUTES=15
CAMERA_STREAM_URL=/camera-stream/api/stream.mp4?src=tapo
# Keep the dedicated camera account only in the ignored/protected .env file and
# URL-encode reserved username/password characters. Never paste the real value in Git.
TAPO_CAMERA_STREAM=
# Family photo processing. Uploaded media lives in the Docker media volume, never in Git.
PHOTO_MAX_UPLOAD_BYTES=20971520
PHOTO_MAX_DIMENSION=2560
PHOTO_THUMBNAIL_MAX_DIMENSION=480
PHOTO_WEBP_QUALITY=88
